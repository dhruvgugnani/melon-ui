{
  "name": "melonui",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "cli"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w melonui-web",
    "dev": "npm run dev -w melonui-web",
    "lint": "npm run lint --workspaces --if-present",
    "test:components": "node scripts/test-component-pages.cjs",
    "validate:registry": "node scripts/validate-registry-sync.cjs"
  }
}
